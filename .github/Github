class TicketView(discord.ui.View):
    def __init__(self):
        super().__init__(timeout=None)

    @discord.ui.button(label="Create Ticket", style=discord.ButtonStyle.primary, emoji="📩")
    async def create_ticket(self, interaction: discord.Interaction, button: discord.ui.Button):
        """Handles ticket creation when button is pressed"""
        user = interaction.user
        await interaction.response.send_message("Check your DMs to provide ticket details!", ephemeral=True)

        # Ask first question
        try:
            dm_channel = await user.create_dm()
            await dm_channel.send("1. What is your maximum budet? (e.g., Bug, Account Help, Purchase Issue)")
            issue_type = await bot.wait_for("message", check=lambda m: m.author == user and isinstance(m.channel, discord.DMChannel), timeout=60)

            # Ask second question
            await dm_channel.send("what are you trying to learn:")
            issue_details = await bot.wait_for("message", check=lambda m: m.author == user and isinstance(m.channel, discord.DMChannel), timeout=120)

        except Exception:
            await user.send("You took too long to respond. Please try again.")
            return

        # Create ticket channel
        guild = bot.get_guild(GUILD_ID)
        category = discord.utils.get(guild.categories, id=CATEGORY_ID)

        if not category:
            await user.send("Ticket category not found! Contact an admin.")
            return

        overwrites = {
            guild.default_role: discord.PermissionOverwrite(read_messages=False),
            user: discord.PermissionOverwrite(read_messages=True, send_messages=True)
        }

        ticket_channel = await guild.create_text_channel(
            f"ticket-{user.name.lower()}",
            category=category,
            overwrites=overwrites
        )

        await ticket_channel.send(
            f"**Ticket Created by {user.mention}**\n\n"
            f"**Issue Type:** {issue_type.content}\n"
            f"**Details:** {issue_details.content}\n\n"
            f"Staff will assist you shortly!"
        )

        await user.send(f"✅ Your ticket has been created: {ticket_channel.mention}")

@bot.command()
async def ticketpanel(ctx):
    """Sends the ticket panel with a button"""
    embed = discord.Embed(title="BloxFruit Support", description="Click the button below to create a ticket.", color=discord.Color.blue())
    view = TicketView()
    await ctx.send(embed=embed, view=view)

@bot.command()
async def close(ctx):
    """Closes the ticket"""
    if ctx.channel.name.startswith("ticket-"):
        await ctx.send("Closing this ticket...")
        await ctx.channel.delete()
    else:
        await ctx.send("This command can only be used inside a ticket channel!")

